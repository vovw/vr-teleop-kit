# TLS material for the LAN transport — generated locally, never committed.
certs/
*.pem

# Local clone of the i2rt repo (YAM model files + hardware driver) — the
# README instructs cloning it here; the model files are deliberately not
# vendored.
i2rt/

# Generated by tools/gen_cams_env.py from the serial->role map — site-local.
cams.env

# Per-run log files written by setup_logging().
logs/
*.log

# MuJoCo writes these next to the CWD: the GLFW/render log, and the model
# and data dumps some viewers emit on load. All site-local noise.
MUJOCO_LOG.TXT
MJMODEL.TXT
MJDATA.TXT
*.mjb

__pycache__/
*.py[cod]
.venv/
*.egg-info/
dist/
build/
.DS_Store

# Recorded episodes (bspline/tidybot2 format recorder)
data/

# Generated MuJoCo scene: build_scene.py bakes absolute mesh paths for this
# checkout into it, so it is rebuilt per machine rather than committed.
#   python sim/build_scene.py --table-color neutral --arm-style translucent
sim/spd_scene.xml

# Debug renders, comparison sheets and fit overlays from the sim tooling, plus
# the cached ideal->distorted remap. All regenerable from the committed
# intrinsics/pose JSON; the one side-by-side the README cites as evidence for
# the joint mapping is kept.
sim/*.png
sim/top_distortion_map.npz
sim/compare/
sim/wrist_fit/
sim/compare_arms/*
!sim/compare_arms/pose04_side_by_side.png
